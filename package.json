{
  "name": "smdd-booth-2026",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run -w client dev",
    "dev:server": "node --env-file=.env --watch-path=./server/src --import tsx ./server/src/index.ts",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "start": "node scripts/start.mjs",
    "test": "npm run test -w shared && npm run test -w server"
  }
}
